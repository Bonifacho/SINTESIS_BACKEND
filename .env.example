# ─────────────────────────────────────────────────────────────────────────────
# SÍNTESIS API — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo como '.env' y completa con tus credenciales reales.
# NUNCA subas el archivo '.env' con valores de producción al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# Entorno Flask (development / production)
FLASK_APP=run.py
FLASK_ENV=development

# Claves criptográficas (deben ser cadenas largas, aleatorias y secretas en producción)
SECRET_KEY=tu_secret_key_aqui_generada_aleatoriamente
JWT_SECRET_KEY=tu_jwt_secret_key_aqui_generada_aleatoriamente

# Conexión a Base de Datos (MySQL / MariaDB / TiDB Cloud)
# Formato: mysql+pymysql://<usuario>:<password>@<host>:<puerto>/<nombre_bd>
DATABASE_URL=mysql+pymysql://usuario:password@localhost:3306/sintesis_db
DATABASE_TEST_URL=mysql+pymysql://usuario:password@localhost:3306/sintesis_test_db
